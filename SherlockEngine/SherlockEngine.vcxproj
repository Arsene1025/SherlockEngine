  <ItemGroup>
    <!-- 4단계(D12): 빌드가 fxc로 .cso를 만들어 exe 옆 Shaders\ 에 둔다. 런타임은 .cso를 우선 로드하고,
         Debug 빌드에서 소스 .hlsl이 더 새로우면 런타임 컴파일로 대체하며 파일 변경을 감시해 핫리로드한다.
         리플렉션(D9)에 쓰므로 /Qstrip_reflect 는 켜지 않는다. -->
    <FxCompile Include="Shaders\BasicVertexShader.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>VS_Main</EntryPointName>
      <ObjectFileOutput>$(OutDir)Shaders\%(Filename).cso</ObjectFileOutput>
      <EnableDebuggingInformation Condition="'$(Configuration)'=='Debug'">true</EnableDebuggingInformation>
      <DisableOptimizations Condition="'$(Configuration)'=='Debug'">true</DisableOptimizations>
    </FxCompile>
    <FxCompile Include="Shaders\BasicPixelShader.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>PS_Main</EntryPointName>
      <ObjectFileOutput>$(OutDir)Shaders\%(Filename).cso</ObjectFileOutput>
      <EnableDebuggingInformation Condition="'$(Configuration)'=='Debug'">true</EnableDebuggingInformation>
      <DisableOptimizations Condition="'$(Configuration)'=='Debug'">true</DisableOptimizations>
    </FxCompile>
    <FxCompile Include="Shaders\ShadowVertexShader.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.0</ShaderModel>
      <EntryPointName>VS_Shadow</EntryPointName>
      <ObjectFileOutput>$(OutDir)Shaders\%(Filename).cso</ObjectFileOutput>
      <EnableDebuggingInformation Condition="'$(Configuration)'=='Debug'">true</EnableDebuggingInformation>
      <DisableOptimizations Condition="'$(Configuration)'=='Debug'">true</DisableOptimizations>
    </FxCompile>
    <None Include="Shaders\Common.hlsli" />
    <None Include="Assets\Textures\uv_checker.png" />
    <None Include="Assets\Textures\bumps_normal.png" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- fxc는 출력 폴더를 만들어 주지 않는다. -->
  <Target Name="EnsureShaderOutputDir" BeforeTargets="FxCompile">
    <MakeDir Directories="$(OutDir)Shaders" />
  </Target>
  <!-- 소스 .hlsl/.hlsli 사본도 exe 옆에 둔다. .cso가 없을 때의 런타임 컴파일 폴백과
       소스 트리가 없는 환경(배포)에서의 핫리로드 대상이다. -->
  <Target Name="CopyShaderSources" AfterTargets="Build">
    <ItemGroup>
      <ShaderSourceFiles Include="$(ProjectDir)Shaders\*.hlsl;$(ProjectDir)Shaders\*.hlsli" />
    </ItemGroup>
    <Copy SourceFiles="@(ShaderSourceFiles)" DestinationFolder="$(OutDir)Shaders" SkipUnchangedFiles="true" />
  </Target>
  <!-- 5단계: 에셋(텍스처)을 exe 옆 Assets\ 로 복사. 실행 파일은 Core/Paths::GetAssetPath 로 찾는다. -->
  <Target Name="CopyAssets" AfterTargets="Build">
    <ItemGroup>
      <AssetFiles Include="$(ProjectDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(OutDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
